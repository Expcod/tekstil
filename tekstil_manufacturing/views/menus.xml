<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Asosiy Client Action (Zamonaviy Interaktiv Boshqaruv Paneli & Planshet) -->
    <record id="action_tekstil_dashboard" model="ir.actions.client">
        <field name="name">Ishlab Chiqarish</field>
        <field name="tag">tekstil_manufacturing_dashboard</field>
    </record>

    <!-- Asosiy Ilova Menyusi -->
    <menuitem
        id="menu_tekstil_root"
        name="Ishlab Chiqarish"
        web_icon="tekstil_manufacturing,static/description/icon.png"
        sequence="15"
        groups="tekstil_manufacturing.group_tekstil_user"/>

    <!-- 1. Boshqaruv va Planshet Paneli -->
    <menuitem
        id="menu_tekstil_dashboard"
        name="Boshqaruv &amp; Planshet"
        parent="menu_tekstil_root"
        action="action_tekstil_dashboard"
        sequence="1"
        groups="tekstil_manufacturing.group_tekstil_user"/>

    <!-- 2. Rejalashtirish Menyusi -->
    <menuitem
        id="menu_tekstil_planning_group"
        name="Rejalashtirish"
        parent="menu_tekstil_root"
        sequence="10"/>

    <menuitem
        id="menu_tekstil_plans"
        name="Haftalik &amp; Oylik Rejalar"
        parent="menu_tekstil_planning_group"
        action="action_tekstil_plans"
        sequence="1"/>

    <!-- 3. Konveyer va Partiyalar -->
    <menuitem
        id="menu_tekstil_production_group"
        name="Ishlab Chiqarish Oqimi"
        parent="menu_tekstil_root"
        sequence="20"/>

    <menuitem
        id="menu_tekstil_batches"
        name="Partiyalar (Kroy &amp; Konveyer)"
        parent="menu_tekstil_production_group"
        action="action_tekstil_batches"
        sequence="1"/>

    <menuitem
        id="menu_tekstil_worker_output"
        name="Xodimlar Unumi (Ishbay Haq)"
        parent="menu_tekstil_production_group"
        action="action_tekstil_worker_outputs"
        sequence="2"/>

    <!-- 4. Sifat Nazorati (OTK) -->
    <menuitem
        id="menu_tekstil_qc_group"
        name="Sifat Nazorati (OTK)"
        parent="menu_tekstil_root"
        sequence="30"/>

    <menuitem
        id="menu_tekstil_qc_checks"
        name="OTK Qabullari"
        parent="menu_tekstil_qc_group"
        action="action_tekstil_qc_checks"
        sequence="1"/>

    <menuitem
        id="menu_tekstil_defects"
        name="Nuqson Turlari (Klassifikator)"
        parent="menu_tekstil_qc_group"
        action="action_tekstil_defect_types"
        sequence="2"
        groups="tekstil_manufacturing.group_tekstil_manager"/>

    <!-- 5. B2B Brandlar va Sub-pudrat -->
    <menuitem
        id="menu_tekstil_commercial_group"
        name="Buyurtmalar &amp; Sub-pudrat"
        parent="menu_tekstil_root"
        sequence="40"/>

    <menuitem
        id="menu_tekstil_brand_orders"
        name="Brand Buyurtmalari (B2B)"
        parent="menu_tekstil_commercial_group"
        action="action_tekstil_brand_orders"
        sequence="1"/>

    <menuitem
        id="menu_tekstil_subcontract"
        name="Sub-pudrat Xizmatlari"
        parent="menu_tekstil_commercial_group"
        action="action_tekstil_subcontract_orders"
        sequence="2"/>
</odoo>
