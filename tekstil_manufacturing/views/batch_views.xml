<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Batch Kanban View (Konveyer Oqimi) -->
    <record id="view_tekstil_batch_kanban" model="ir.ui.view">
        <field name="name">tekstil.production.batch.kanban</field>
        <field name="model">tekstil.production.batch</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage" quick_create="false" class="o_kanban_small_column">
                <field name="name"/>
                <field name="product_id"/>
                <field name="color"/>
                <field name="quantity"/>
                <field name="stage"/>
                <field name="state"/>
                <field name="current_worker_id"/>
                <field name="roll_number"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <strong class="text-primary"><field name="name"/></strong>
                            <span class="badge bg-secondary"><field name="quantity"/> dona</span>
                        </div>
                        <div class="fw-bold fs-6 mb-1 text-truncate"><field name="product_id"/></div>
                        <div class="small text-muted mb-2">
                            <span>Rang: <field name="color"/></span> | 
                            <span>Rulon: <field name="roll_number"/></span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                            <span class="small text-dark">
                                <i class="fa fa-user me-1 text-muted"/>
                                <field name="current_worker_id"/>
                            </span>
                            <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'in_progress'" decoration-success="state == 'done'"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Batch List View -->
    <record id="view_tekstil_batch_tree" model="ir.ui.view">
        <field name="name">tekstil.production.batch.tree</field>
        <field name="model">tekstil.production.batch</field>
        <field name="arch" type="xml">
            <list string="Partiyalar">
                <field name="name"/>
                <field name="product_id"/>
                <field name="color"/>
                <field name="roll_number"/>
                <field name="quantity" sum="Jami Dona"/>
                <field name="stage" widget="badge"/>
                <field name="current_worker_id"/>
                <field name="qc_passed_qty" sum="Jami 1-nav"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- Batch Form View -->
    <record id="view_tekstil_batch_form" model="ir.ui.view">
        <field name="name">tekstil.production.batch.form</field>
        <field name="model">tekstil.production.batch</field>
        <field name="arch" type="xml">
            <form string="Ishlab Chiqarish Partiyasi (Kroy)">
                <header>
                    <button name="action_start" type="object" string="Konveyerga Chiqarish" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_next_stage" type="object" string="Keyingi Bosqichga O'tkazish" class="btn-success" invisible="state != 'in_progress' or stage == 'done'"/>
                    <field name="stage" widget="statusbar" statusbar_visible="cutting,sewing,subcontract,ironing,qc,packing,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Partiya Raqami"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Asosiy Ma'lumotlar">
                            <field name="product_id"/>
                            <field name="color"/>
                            <field name="quantity"/>
                            <field name="size_breakdown" placeholder="S:100, M:200, L:150, XL:50"/>
                        </group>
                        <group string="Xomashyo va Bog'lanish">
                            <field name="roll_number" placeholder="Mato ruloni kodi (RUL-001)"/>
                            <field name="fabric_used_kg"/>
                            <field name="current_worker_id"/>
                            <field name="line_code"/>
                            <field name="plan_id"/>
                            <field name="brand_order_id"/>
                        </group>
                    </group>
                    <group string="Bosqichlardagi Hisobot">
                        <group>
                            <field name="cutting_qty"/>
                            <field name="sewing_qty"/>
                            <field name="ironing_qty"/>
                        </group>
                        <group>
                            <field name="qc_passed_qty"/>
                            <field name="qc_defect_qty"/>
                            <field name="packed_qty"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Xodimlar Yozuvlari (Planshet)" name="workers">
                            <field name="worker_output_ids" readonly="1">
                                <list>
                                    <field name="datetime"/>
                                    <field name="employee_id"/>
                                    <field name="department"/>
                                    <field name="operation_name"/>
                                    <field name="quantity"/>
                                    <field name="total_wage"/>
                                </list>
                            </field>
                        </page>
                        <page string="OTK Sifat Tekshiruvlari" name="qc">
                            <field name="quality_check_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="inspector_id"/>
                                    <field name="check_date"/>
                                    <field name="inspected_qty"/>
                                    <field name="grade_1_qty"/>
                                    <field name="pass_rate" widget="progressbar"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Batch Action -->
    <record id="action_tekstil_batches" model="ir.actions.act_window">
        <field name="name">Partiyalar (Konveyer Oqimi)</field>
        <field name="res_model">tekstil.production.batch</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Yangi partiya (kroy) yarating va konveyerga qo'ying!
            </p>
        </field>
    </record>
</odoo>
