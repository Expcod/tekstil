<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_tekstil_manufacturing" model="ir.module.category">
        <field name="name">Tekstil Ishlab Chiqarish</field>
        <field name="description">Tekstil rejalashtirish, konveyer, sifat nazorati va planshet boshqaruvi</field>
        <field name="sequence">85</field>
    </record>

    <record id="privilege_tekstil_manufacturing" model="res.groups.privilege">
        <field name="name">Tekstil Boshqaruvi</field>
        <field name="category_id" ref="module_category_tekstil_manufacturing"/>
        <field name="sequence">10</field>
    </record>

    <record id="group_tekstil_user" model="res.groups">
        <field name="name">Foydalanuvchi / Usta</field>
        <field name="privilege_id" ref="privilege_tekstil_manufacturing"/>
        <field name="comment">Tekstil ishlab chiqarish va planshetdan foydalanish huquqi</field>
    </record>

    <record id="group_tekstil_manager" model="res.groups">
        <field name="name">Boshqaruvchi / Menejer</field>
        <field name="privilege_id" ref="privilege_tekstil_manufacturing"/>
        <field name="implied_ids" eval="[(4, ref('group_tekstil_user'))]"/>
        <field name="comment">Barcha reja, partiya, OTK va tijorat amallarini boshqarish huquqi</field>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_tekstil_manager'))]"/>
    </record>
</odoo>
