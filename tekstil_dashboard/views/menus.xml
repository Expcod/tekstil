<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Client Action for Tekstil ERP Dashboard -->
    <record id="action_tekstil_dashboard_client" model="ir.actions.client">
        <field name="name">Dashboard</field>
        <field name="tag">tekstil_dashboard_app</field>
    </record>

    <!-- Top-level App Menu: Dashboard -->
    <menuitem id="menu_tekstil_dashboard_root"
              name="Dashboard"
              web_icon="tekstil_dashboard,static/description/icon.png"
              sequence="2"/>

    <!-- Sub-menu item pointing to client action -->
    <menuitem id="menu_tekstil_dashboard_main"
              name="Boshqaruv Paneli"
              parent="menu_tekstil_dashboard_root"
              action="action_tekstil_dashboard_client"
              sequence="1"/>
</odoo>
